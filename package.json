{
  "type": "module",
  "private": true,
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "rimraf dist && tsx scripts/talk.ts build --all && pnpm run build:index",
    "build:index": "tsx scripts/createIndex.ts",
    "readme": "tsx scripts/updateReadme.ts",
    "readme:check": "tsx scripts/updateReadme.ts --check",
    "dev": "tsx scripts/talk.ts dev",
    "export": "tsx scripts/talk.ts export",
    "test": "vitest run",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "devDependencies": {
    "@antfu/eslint-config": "catalog:",
    "@slidev/theme-default": "catalog:",
    "@types/node": "catalog:",
    "@types/prompts": "catalog:",
    "eslint": "catalog:",
    "eslint-plugin-format": "catalog:",
    "execa": "catalog:",
    "pnpm": "catalog:",
    "prettier-plugin-slidev": "catalog:",
    "prompts": "catalog:",
    "rimraf": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "vue-tsc": "catalog:"
  }
}
