{
  "type": "module",
  "private": true,
  "packageManager": "pnpm@12.14.0",
  "scripts": {
    "build": "rimraf dist && pnpm -r run build && pnpm run build:index",
    "build:index": "tsx scripts/createIndex.ts",
    "readme": "tsx scripts/updateReadme.ts",
    "readme:check": "tsx scripts/updateReadme.ts --check",
    "dev": "esno scripts/picker.ts dev",
    "test": "vitest run",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "devDependencies": {
    "@antfu/eslint-config": "catalog:",
    "@slidev/theme-default": "catalog:",
    "@types/node": "catalog:",
    "@types/prompts": "catalog:",
    "eslint": "catalog:",
    "eslint-plugin-format": "catalog:",
    "esno": "catalog:",
    "execa": "catalog:",
    "pnpm": "catalog:",
    "prettier-plugin-slidev": "catalog:",
    "prompts": "catalog:",
    "rimraf": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "vue-tsc": "catalog:"
  }
}
