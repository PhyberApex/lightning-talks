{
  "compilerOptions": {
    "target": "esnext",
    "module": "esnext",
    "moduleResolution": "bundler",
    "paths": {
      "@slidev/client": [
        "./packages/theme/slidev-client.d.ts"
      ]
    },
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true
  },
  "include": [
    "scripts/**/*",
    "packages/theme/**/*",
    "*/src/**/*"
  ],
  "exclude": [
    "**/node_modules",
    "dist",
    "*/src/snippets"
  ]
}
